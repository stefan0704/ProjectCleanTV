<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the quick settings panel (QuickSettingsActivity): icon, title, value on the right; the thin bar is only for Volume. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:tint="@drawable/pill_text"
            android:duplicateParentState="true"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="16sp"
            android:fontFamily="@string/font_medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:textColor="@drawable/pill_text_dim"
            android:duplicateParentState="true"
            android:textSize="14sp"
            android:fontFamily="@string/font_body"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="5dp"
        android:visibility="gone" />
</FrameLayout>
